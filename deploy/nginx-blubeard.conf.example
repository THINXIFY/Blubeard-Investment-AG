# Copy to /etc/nginx/sites-available/blubeard, replace the domain, then add HTTPS with certbot.
server {
    listen 80;
    server_name blubeard-investment.com www.blubeard-investment.com;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        # Required: the document API compares Origin with Host, and rate limits use the client address.
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # The documents email can take a while to send.
        proxy_read_timeout 75s;
    }
}
