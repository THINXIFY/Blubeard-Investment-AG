# Public canonical URL used for metadata, sitemap and structured data. Built into the pages: set it before `npm run build`.
NEXT_PUBLIC_SITE_URL=https://www.blubeard-investment.com

# ---- Request Private Documents (server-side only; never prefix these with NEXT_PUBLIC_) ----
# Resend API key. Without it, development shows a local preview and production reports "temporarily unavailable".
RESEND_API_KEY=
# Sender on a Resend-verified domain.
DOCUMENTS_FROM_EMAIL="Blubeard Investment AG <info@blubeard-investment.com>"
# Required in production, 32+ random characters:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
OTP_HASH_SECRET=
# Optional tuning (defaults shown)
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60
# Absolute path to the private PDFs, outside the project on a server (local default: ./private/documents).
DOCUMENTS_DIR=
# Optional: challenge store file (default ./.data/otp-challenges.json)
OTP_STORE_PATH=
# Optional: provider endpoint override, for testing only
RESEND_API_URL=
